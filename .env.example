# Slack tokens
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Slack channel ID where notifications will be posted
SLACK_CHANNEL_ID=C1234567890

# Admin user ID for cookie expiry alerts and notifications
# Get your User ID: Click your Slack profile → More → Copy member ID
ADMIN_USER_ID=U01234ABCDE

# Advent of Code
AOC_SESSION_COOKIE=session=your_session_cookie_here
AOC_LEADERBOARD_ID=5123211
AOC_YEAR=2025

# User-Agent for AoC API requests (REQUIRED - include contact info!)
# AoC requires this so they can contact you if your bot misbehaves
AOC_USER_AGENT=AoC-Slack-Bot/1.0 (+https://github.com/youruser/aoc-slack-bot; your.email@example.com)

# Cookie age monitoring (optional, default: true)
# Sends daily reminders to admin when cookie is >21 days old
AOC_COOKIE_AGE_REMINDERS=true

# Polling - uses cron schedule in production (:00, :20, :40 every hour)
# No longer uses POLL_INTERVAL_SECONDS in production mode

# Development mode (set to 'true' for mock data and faster polling)
# IMPORTANT: DEV_MODE uses MOCK data and does NOT hit the real AoC API
DEV_MODE=false
DEV_POLL_INTERVAL_SECONDS=60
